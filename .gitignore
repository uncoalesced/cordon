# Characterization output: raw sample streams and marker logs are run artifacts,
# not source. Curated result sets get committed explicitly under docs/data/.
runs/
*.jsonl
!docs/data/*.jsonl

# Local-only agent spec. Removed from git history entirely (git filter-repo) since the repo
# is public; this just stops it from being re-added by accident.
CLAUDE.md

# Salvage copies left behind by git repair attempts.
.git-broken*/
.git-oldswap*/

.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
